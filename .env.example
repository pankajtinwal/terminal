# Supabase Configuration
# Found in: Supabase Project Settings -> API (Project URL & Anon public key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Configuration (INR Payment Gateway)
# Found in: Razorpay Dashboard -> Settings -> API Keys (Key Id)
# Starts with rzp_test_ (for sandbox testing) or rzp_live_ (for production)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# Brand / App Meta
VITE_APP_NAME=QuantNSE
